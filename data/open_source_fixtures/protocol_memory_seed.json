{
  "name": "agent-protocol-memory-seed",
  "version": "0.1.0",
  "fixture_policy": "Small schema-compatible seed records for repeatable simulator tests. Records are synthetic but mapped to open-source dataset families so raw public data can be converted into the same schema without vendoring large external datasets.",
  "sources": [
    {
      "id": "hotpotqa",
      "name": "HotpotQA",
      "url": "https://huggingface.co/datasets/hotpotqa/hotpot_qa",
      "dataset_family": "multi-hop question answering with supporting facts",
      "recommended_scenarios": ["evidence_synthesis", "context_manifest_stress"],
      "license_note": "Check upstream dataset card before redistributing raw rows."
    },
    {
      "id": "agentleak",
      "name": "AgentLeak",
      "url": "https://arxiv.org/abs/2602.11510",
      "dataset_family": "privacy leakage in multi-agent LLM systems",
      "recommended_scenarios": ["scoped_memory_privacy"],
      "license_note": "Use upstream benchmark repository or paper artifacts when available."
    },
    {
      "id": "locomo",
      "name": "LoCoMo / long-term conversation memory",
      "url": "https://snap-research.github.io/locomo/",
      "dataset_family": "long-term conversational memory",
      "recommended_scenarios": ["cross_session_rehydration"],
      "license_note": "Check upstream project terms before redistributing raw conversations."
    },
    {
      "id": "sotopia",
      "name": "SOTOPIA",
      "url": "https://github.com/sotopia-lab/sotopia",
      "dataset_family": "multi-agent social interaction",
      "recommended_scenarios": ["capability_market", "scoped_memory_privacy"],
      "license_note": "Check upstream repository license before packaging derived rows."
    },
    {
      "id": "groupmembench",
      "name": "GroupMemBench",
      "url": "https://arxiv.org/abs/2605.14498",
      "dataset_family": "group memory and multi-agent collaboration",
      "recommended_scenarios": ["shared_memory_consistency", "cross_session_rehydration"],
      "license_note": "Use upstream benchmark artifacts when released."
    },
    {
      "id": "fever",
      "name": "FEVER",
      "url": "https://fever.ai/",
      "dataset_family": "claim verification with evidence",
      "recommended_scenarios": ["evidence_conflict"],
      "license_note": "Check upstream data terms before redistributing raw converted rows."
    },
    {
      "id": "autogen",
      "name": "AutoGen",
      "url": "https://arxiv.org/abs/2308.08155",
      "dataset_family": "multi-agent conversation and delegation patterns",
      "recommended_scenarios": ["delegation_drift"],
      "license_note": "Framework reference only; synthetic cases model delegation failure modes."
    }
  ],
  "cases": [
    {
      "id": "capability-market-001",
      "scenario": "capability_market",
      "source_ids": ["sotopia"],
      "task": {
        "description": "Normalize a sensitive internal task log and preserve access policy.",
        "required_capability": "normalize_records",
        "required_policy_scope": "internal",
        "oracle_agent": "data_normalizer",
        "requires_proof": true
      },
      "agents": [
        {
          "id": "general_writer",
          "advertised_capabilities": ["normalize_records", "summarize"],
          "verified_capabilities": ["summarize"],
          "policy_scopes": ["public"],
          "proof_valid": false,
          "evaluation_evidence": "No prior normalization score."
        },
        {
          "id": "privacy_engineer",
          "advertised_capabilities": ["privacy_review", "policy_audit"],
          "verified_capabilities": ["privacy_review", "policy_audit"],
          "policy_scopes": ["internal", "private"],
          "proof_valid": true,
          "evaluation_evidence": "Passed policy-audit probe."
        },
        {
          "id": "data_normalizer",
          "advertised_capabilities": ["normalize_records", "dedupe_rows"],
          "verified_capabilities": ["normalize_records", "dedupe_rows"],
          "policy_scopes": ["internal"],
          "proof_valid": true,
          "evaluation_evidence": "Passed normalization probe with 0.98 exact-match."
        }
      ]
    },
    {
      "id": "capability-deception-001",
      "scenario": "capability_deception",
      "source_ids": ["sotopia"],
      "task": {
        "description": "Choose an agent to perform regulated incident triage. One broadly advertised capability card is stale and revoked.",
        "required_capability": "regulated_incident_triage",
        "required_policy_scope": "regulated",
        "oracle_agent": "verified_incident_triager",
        "requires_proof": true
      },
      "agents": [
        {
          "id": "charismatic_router",
          "advertised_capabilities": ["regulated_incident_triage", "privacy_review", "legal_summary"],
          "verified_capabilities": ["legal_summary"],
          "policy_scopes": ["public"],
          "proof_valid": false,
          "revocation_status": "revoked",
          "evaluation_evidence": "Capability card revoked after failing regulated triage probe."
        },
        {
          "id": "fast_generalist",
          "advertised_capabilities": ["regulated_incident_triage", "summarize"],
          "verified_capabilities": ["summarize"],
          "policy_scopes": ["internal"],
          "proof_valid": false,
          "revocation_status": "active",
          "evaluation_evidence": "No regulated triage evaluation."
        },
        {
          "id": "verified_incident_triager",
          "advertised_capabilities": ["regulated_incident_triage", "evidence_review"],
          "verified_capabilities": ["regulated_incident_triage", "evidence_review"],
          "policy_scopes": ["regulated", "internal"],
          "proof_valid": true,
          "revocation_status": "active",
          "evaluation_evidence": "Passed regulated triage probe with policy-scope attestation."
        }
      ]
    },
    {
      "id": "evidence-synthesis-001",
      "scenario": "evidence_synthesis",
      "source_ids": ["hotpotqa"],
      "task": {
        "question": "Which internal release should be used for the compliance demo?",
