    {
      "id": "delegation-drift-001",
      "scenario": "delegation_drift",
      "source_ids": ["autogen", "groupmembench"],
      "task": {
        "description": "Complete a three-step delegated report without marking terminal success before all committed deliverables are written.",
        "required_deliverables": ["evidence_capsules_written", "privacy_review_done", "final_report_written"],
        "required_evidence_ids": ["fact-current-region", "fact-policy-binding"],
        "premature_completion_markers": ["final_report_written"],
        "success_predicate": "All three deliverables must be recorded before completed."
      },
      "delegation": {
        "sender": "coordinator",
        "receiver": "executor",
        "deadline": "2026-05-21T12:00:00Z",
        "budget_tokens": 2000,
        "authority_scope": "task",
        "failure_modes": ["missing_evidence", "privacy_review_skipped", "premature_terminal_state"]
      }
    },
